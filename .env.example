# Resend (https://resend.com) — transactional email for contact form + lead capture
RESEND_API_KEY=

# Address that receives contact-form and lead-capture notification emails
CONTACT_TO_EMAIL=umenduengineeringservicesltd@gmail.com

# Verified sender address in Resend (must be on a domain verified in the Resend dashboard).
# Until umendumarine.com (or e.g. mail.umendumarine.com) is verified, use Resend's sandbox
# sender onboarding@resend.dev for local testing — note sandbox mail only delivers to the
# Resend account owner's own verified email address, not to arbitrary inboxes.
RESEND_FROM_EMAIL=Umendu Marine Website <onboarding@resend.dev>
